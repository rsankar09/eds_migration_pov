      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Icon Feature",
              "filter": "icon-feature"
            }
          }
        }
      }
    },
    {
      "title": "Icon Feature Item",
      "id": "icon-feature-item",
