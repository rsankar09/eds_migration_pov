        },
        {
          "component": "select",
          "valueType": "string",
          "name": "copy_headingType",
          "label": "Heading Type",
          "value": "h3",
          "options": [
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "copy_description",
          "label": "Description",
          "value": ""
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "copy_cta",
          "label": "CTA Link"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "copy_ctaText",
